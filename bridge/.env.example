# Copy outside Git into your secret manager; replace every placeholder.
# Notifier: Contents read / Metadata read, installed only on author repositories.
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
NOTIFIER_APP_ID=REPLACE_NOTIFIER_NUMERIC_APP_ID
NOTIFIER_PRIVATE_KEY=REPLACE_NOTIFIER_PEM_WITH_LITERAL_BACKSLASH_N
# Registry writer: Contents write / Pull requests write / Metadata read,
# installed only on the official registry. Must be a DIFFERENT GitHub App.
REGISTRY_APP_ID=REPLACE_REGISTRY_NUMERIC_APP_ID
REGISTRY_PRIVATE_KEY=REPLACE_REGISTRY_PEM_WITH_LITERAL_BACKSLASH_N
REGISTRY_REPOSITORY=OWNER/bepack-registry
# Exactly one replica. Mount /data as a reliable writable persistent volume.
BRIDGE_DATA_DIR=/data
BRIDGE_INTERVAL_MS=5000
HOST=0.0.0.0
PORT=8787