{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bepack.dev/schemas/source.schema.json",
  "title": "BePack registry source record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "repository", "contact", "enabled", "proof"],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$", "maxLength": 128 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "full_name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "full_name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
      }
    },
    "contact": { "type": "string", "pattern": "^https://" },
    "enabled": { "type": "boolean" },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit"],
      "properties": {
        "path": { "const": ".bepack-registry.json" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}
