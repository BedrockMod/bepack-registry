{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bepack.dev/schemas/registry.schema.json",
  "title": "BePack registry catalog root",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "generated_at", "revision", "packs"],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_id": { "const": "bepack-registry" },
    "generated_at": { "type": "string", "format": "date-time" },
    "revision": { "type": "string", "format": "uuid" },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "author", "license", "mode", "latest", "latest_prerelease", "state", "updated_at", "detail"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$", "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "description": { "type": "string", "maxLength": 10000 },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "url": { "type": "string", "pattern": "^https://" },
              "email": { "type": "string", "maxLength": 254 }
            }
          },
          "license": { "type": "string", "minLength": 1, "maxLength": 256 },
          "mode": { "enum": ["full", "modded", "client", "mods-only"] },
          "latest": {
            "oneOf": [
              { "type": "null" },
              { "type": "string" }
            ]
          },
          "latest_prerelease": {
            "oneOf": [
              { "type": "null" },
              { "type": "string" }
            ]
          },
          "state": { "enum": ["active", "inactive"] },
          "updated_at": { "type": "string", "format": "date-time" },
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^packs/[0-9a-f]{64}\\.json$" },
              "size": { "type": "integer", "minimum": 1, "maximum": 4194304 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
