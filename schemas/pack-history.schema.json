{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bepack.dev/schemas/pack-history.schema.json",
  "title": "BePack content-addressed pack history detail",
  "$comment": "Each versions[] item is a release-record.schema.json object with the server-managed state fields added. The generator and validators enforce the full release-record contract; this schema focuses on the history envelope and state extension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "repository", "versions"],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$", "maxLength": 128 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "full_name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "full_name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema_version", "pack_id", "version", "version_set", "mode", "name", "description",
          "author", "license", "package_schema_version", "repository", "release", "package",
          "manifest", "descriptor", "scan_report", "targets", "executables", "verification",
          "evidence", "state", "reason", "state_changed_at", "advisory_url"
        ],
        "properties": {
          "state": { "enum": ["active", "yanked", "quarantined", "unavailable"] },
          "reason": { "type": "string", "maxLength": 2000 },
          "state_changed_at": { "type": "string", "format": "date-time" },
          "advisory_url": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^https://" }
            ]
          },
          "version": { "type": "string" },
          "pack_id": { "type": "string" },
          "repository": { "type": "object" },
          "release": { "type": "object" },
          "package": { "type": "object" },
          "manifest": { "type": "object" },
          "descriptor": { "type": "object" },
          "scan_report": { "type": "object" },
          "targets": { "type": "array" },
          "executables": { "type": "array" },
          "verification": { "type": "object" },
          "evidence": { "type": "array" },
          "author": { "type": "object" }
        }
      }
    }
  }
}
